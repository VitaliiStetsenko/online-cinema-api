# Database
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/online_cinema
DATABASE_SYNC_URL=postgresql+psycopg://user:password@db:5432/online_cinema

# JWT
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Public frontend and allowed browser origins
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
AUTH_RATE_LIMIT=5/minute

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-password
EMAIL_FROM=noreply@cinema.com

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=avatars
MINIO_SECURE=false

# App
APP_TITLE=Online Cinema
APP_VERSION=1.0.0
DEBUG=true
